# Obrigatória em produção: senha da área administrativa.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Recomendada: segredo separado para assinar a sessão do administrador.
# Se não for definida, a senha é usada para assinar. Com ela definida, trocar a senha não encerra sessões.
# ADMIN_SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Repositório GitHub usado como armazenamento do conteúdo (sem banco de dados).
# O repositório pode ser público ou privado. O token só é usado no servidor.
GITHUB_OWNER=seu-usuario
GITHUB_REPO=gostinho-do-paraense
GITHUB_BRANCH=main
GITHUB_CONTENT_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
